# ─── IA APIs ──────────────────────────────────────────────────
COHERE_API_KEY=
MISTRAL_API_KEY=

# ─── HuggingFace — Meta MMS Speech STT (Premium) ─────────────
# Crear token en huggingface.co/settings/tokens (tipo: Read)
HF_TOKEN=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=        # Para generate_missions.js y bots de contenido (Admin → Bots)

# ─── Auth ─────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Token para endpoints /admin — generar igual que JWT_SECRET
ADMIN_TOKEN=

# Usuario admin inicial (se crea al arrancar el servidor si no existe)
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Bypass de desarrollo: cualquier cuenta + esta contraseña loguea como isDev=true
# Dejar VACÍO en producción — se ignora automáticamente si NODE_ENV=production
DEV_PASSWORD=

# ─── CORS ─────────────────────────────────────────────────────
# Orígenes permitidos en producción (separados por coma)
ALLOWED_ORIGINS=https://tu-dominio.com

# ─── Servicios ────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=SenseMate <noreply@sensemate.app>

# ─── App ──────────────────────────────────────────────────────
DB_PATH=./lingua_users.db
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
