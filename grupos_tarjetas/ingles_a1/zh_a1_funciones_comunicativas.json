[
  {
    "id": "zh_A1_func_01",
    "type": "concept",
    "category": "Funciones comunicativas",
    "title": "问候并介绍自己",
    "bridge": "在西班牙语中，我们用‘Hola’或‘Buenos días’来打招呼，用‘Me llamo...’或‘Soy...’来介绍自己。在英语中类似：我们使用‘Hello’或‘Good morning’，并说‘My name is...’或‘I am...’。关键区别在于英语中不会说‘I am called...’（虽然语法正确，但在日常对话中听起来非常正式且不自然）。另外，记住在英语中询问名字时总是使用动词‘to be’：‘What is your name?’（而不是‘How are you called?’）。",
    "rule": "打招呼：‘Hello’（你好），‘Hi’（更 informal），‘Good morning’（早上好），‘Good afternoon’（下午好），‘Good evening’（晚上好）。介绍自己：‘My name is...’（我叫...）或‘I am...’（我是...）。询问名字：‘What is your name?’（你叫什么名字？）。回应问候：‘Nice to meet you’（很高兴认识你），对方回答：‘Nice to meet you too’（我也很高兴认识你）。告别：‘Goodbye’（再见），‘Bye’（拜拜），‘See you later’（回头见）。",
    "concept_examples": [
      {
        "text": "Hello, my name is Maria.",
        "translation": "你好，我叫玛丽亚。",
        "phonetic": "/həˈləʊ maɪ neɪm ɪz məˈriːə/"
      },
      {
        "text": "Good morning, I am Peter.",
        "translation": "早上好，我是彼得。",
        "phonetic": "/ɡʊd ˈmɔːnɪŋ aɪ æm ˈpiːtə/"
      },
      {
        "text": "Nice to meet you.",
        "translation": "很高兴认识你。",
        "phonetic": "/naɪs tə miːt juː/"
      },
      {
        "text": "What is your name?",
        "translation": "你叫什么名字？",
        "phonetic": "/wɒt ɪz jɔː neɪm/"
      }
    ],
    "common_error": {
      "wrong": "I am called Anna.",
      "correct": "My name is Anna.",
      "correct_alt": "I am Anna.",
      "explanation": "在西班牙语中我们说‘Me llamo Anna’，但在英语中最常见的自我介绍方式是‘My name is...’或‘I am...’。‘I am called’是正确的，但在日常场合听起来非常正式且不自然。"
    },
    "levels": [
      {
        "level": 1,
        "label": "Basic greeting",
        "translation": "基本问候",
        "examples": [
          {
            "original": "Hello!",
            "phonetic": "/həˈləʊ/",
            "translation": "你好！",
            "note": "标准问候语。"
          }
        ]
      },
      {
        "level": 2,
        "label": "Introduce yourself",
        "translation": "自我介绍",
        "examples": [
          {
            "original": "My name is John.",
            "phonetic": "/maɪ neɪm ɪz dʒɒn/",
            "translation": "我叫约翰。",
            "note": "说出自己名字的常见方式。"
          }
        ]
      },
      {
        "level": 3,
        "label": "Ask someone's name",
        "translation": "询问名字",
        "examples": [
          {
            "original": "What is your name?",
            "phonetic": "/wɒt ɪz jɔː neɪm/",
            "translation": "你叫什么名字？",
            "note": "直接询问名字的问题。"
          }
        ]
      },
      {
        "level": 4,
        "label": "Farewell",
        "translation": "告别",
        "examples": [
          {
            "original": "See you tomorrow!",
            "phonetic": "/siː juː təˈmɒrəʊ/",
            "translation": "明天见！",
            "note": "非正式告别。"
          }
        ]
      }
    ],
    "conversation": {
