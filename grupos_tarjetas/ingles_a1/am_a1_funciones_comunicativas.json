  {
    "id": "am_A1_func_03",
    "type": "concept",
    "category": "Funciones comunicativas",
    "title": "Describe objects and people (basic)",
    "bridge": "እስከት ውስጥ, መገንባትን እና ሰዎችን ያልተለመዱ ስም በኋላ ያለ አጭብግ ይጠቀማል: 'አንድ ቀዳማይ መኪና', 'አንድ ታላቅ ልጅ'። እንግሊዝኛ ውስጥ, አጭብግ ስም በፊት ይመጣል: 'a red car', 'a tall girl'። ደግሞ የ'to be' እንዲሁም 'have got' ሥልጣናትን ለአጠቃላይ መግለጫት (She is tall) እና ለጥንታዊ ልዩነቶች (She has got blue eyes) ይጠቀማል።",
    "rule": "መግለጫ: 1) አጭብግ + ስም (a big house)። 2) ትርጉም + 'to be' + አጭብግ (The house is big)። 3) ትርጉም + 'have/has got' + ልዩነት (She has got long hair)። ጥሩ አጭብግዎች: big (ታላቅ), small (ጥቁር), tall (ታላቅ), short (ጥቁር), beautiful (ጥበብ), old (እያንዳንዱ), young (ወጣት), fast (በፍጹም), slow (በቀላሉ)።",
    "concept_examples": [
      {
        "text": "This is a big house.",
        "translation": "ይህ ታላቅ ቤት ነው።",
        "phonetic": "/ðɪs ɪz ə bɪɡ haʊs/"
      },
      {
        "text": "She is tall and thin.",
        "translation": "እርስዋ ታላቅ እና ጥቁር ነው።",
        "phonetic": "/ʃiː ɪz tɔːl ænd θɪn/"
      },
      {
        "text": "He has got blue eyes.",
        "translation": "እሱ ሰበሰብ ሆይ አስተዳደር አላቸው።",
        "phonetic": "/hiː hæz ɡɒt bluː aɪz/"
      },
      {
        "text": "The car is red.",
        "translation": "መኪናው ቀዳማይ ነው።",
        "phonetic": "/ðə kɑːr ɪz red/"
      }
    ],
    "common_error": {
      "wrong": "a car red",
      "correct": "a red car",
      "correct_alt": "",
      "explanation": "እስከት ውስጥ, አጭብግ ስም በኋላ ይመጣል ('አንድ ቀዳማይ መኪና')፣ ይሁን እንግሊዝኛ ውስጥ አጭብግ ስም በፊት ይመጣል ('a red car')። ይህ ለእስከት ቋንቋ ወቅቶች ምርጥ ስህተት ነው።"
    },
    "levels": [
      {
        "level": 1,
        "label": "Adjective + noun",
        "translation": "አጭብግ + ስም",
        "examples": [
          {
            "original": "a small dog",
            "phonetic": "/ə smɔːl dɒɡ/",
            "translation": "አንድ ጥቁር ዶግ",
            "note": "አጭብግ ስም በፊት ይመጣል።"
          }
        ]
      },
      {
        "level": 2,
        "label": "Subject + to be + adjective",
        "translation": "ትርጉም + to be + አጭብግ",
        "examples": [
          {
            "original": "The book is interesting.",
            "phonetic": "/ðə bʊk ɪz ˈɪntrəstɪŋ/",
            "translation": "መጽሐፍው የሚያስተዳደር ነው።",
            "note": "'to be' ለአጠቃላይ መግለጫት ይጠቀማል።"
          }
        ]
      },
      {
        "level": 3,
        "label": "have/has got for features",
        "translation": "have/has got ለልዩነቶች",
        "examples": [
          {
            "original": "She has got curly hair.",
            "phonetic": "/ʃiː hæz ɡɒt ˈkɜːli heə/",
            "translation": "እርስዋ ተራራ አስተዳደር አላታ።",
            "note": "'have got' ለጥንታዊ ልዩነቶች ይጠቀማል።"
          }
        ]
      },
      {
        "level": 4,
        "label": "Combined description",
        "translation": "አካባቢ መግለጫ",
        "examples": [
          {
            "original": "My brother is young and he has got green eyes.",
            "phonetic": "/maɪ ˈbrʌðə ɪz jʌŋ ænd hiː hæz ɡɒt ɡriːn aɪz/",
            "translation": "ወንድም ወንድሟዬ ወጣት ነው እና ሰበሰብ ሆይ አስተዳደር አላቸው።",
            "note": "'to be' እና 'have got' አካባቢ።"
          }
        ]
      }
    ],
    "conversation": {
      "vocabulary": [],
      "dialogue": []
    },
    "translations": {
      "am": "አማርኛ"
    }
  }
]