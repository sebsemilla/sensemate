        "label": "Questions",
        "translation": "ጠየቃዎች",
        "examples": [
          {
            "original": "Where are you from?",
            "phonetic": "/weə ɑːr juː frɒm/",
            "translation": "ከየት ነው?",
            "note": "የምድብ ስለት ጠየቂያ።"
          }
        ]
      }
    ],
    "conversation": {
