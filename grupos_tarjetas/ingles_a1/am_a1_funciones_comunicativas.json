  {
    "id": "am_A1_func_02",
    "type": "concept",
    "category": "Funciones comunicativas",
    "title": "Give personal information (age, nationality, profession)",
    "bridge": "ስፓኒሽኛአን, የወጣትን ዘመን ማገልገል ለማወቅ 'Tengo 25 años' (የ'ተን' እንቅስቃሴ የሚጠቀም) እንላለን፣ የእንግሊዝኛ ግን 'I am 25 years old' (የ'to be' እንቅስቃሴ የሚጠቀም) ማለትም ነው። የብሄር ስም ማገልገል ለማወቅ ደግሞ 'Soy español' (በርድ ያልሆነ) እንላለን፣ የእንግሊዝኛ ግን 'I am Spanish' (በርድ ያልሆነ) ማለትም ነው። የሥራ ስም ማገልገል ለማወቅ ደግሞ፣ ስፓኒሽኛአን 'Soy profesor' (በርድ ያልሆነ) እንላለን፣ የእንግሊዝኛ ግን በርድ ያስፈልጋል፦ 'I am a teacher'።",
    "rule": "የወጣትን ዘመን፦ 'I am [ቁጥር] years old' (ሙሉ መጣህል፦ I am 25 years old)። የብሄር ስም፦ 'I am [ብሄር ስም]' (ሙሉ መጣህል፦ I am Spanish, I am Mexican)። የሥራ ስም፦ 'I am a/an [የሥራ ስም]' (ሙሉ መጣህል፦ I am a doctor, I am an engineer)። ለመጠየቅ፦ 'How old are you?' (መዓልትዎ ስለሚሆን?)፣ 'Where are you from?' (ከየት ነው?)፣ 'What do you do?' (ምን ትሰራለት?) ወይም 'What is your job?'።",
    "concept_examples": [
      {
        "text": "I am 25 years old.",
        "translation": "የኔ 25 ዓመት ነው።",
        "phonetic": "/aɪ æm ˈtwenti faɪv jɪəz əʊld/"
      },
      {
        "text": "I am Spanish.",
        "translation": "ስፓኒሽ ነኝ/ና።",
        "phonetic": "/aɪ æm ˈspænɪʃ/"
      },
      {
        "text": "I am a teacher.",
        "translation": "ምክትል ነኝ/ና።",
        "phonetic": "/aɪ æm ə ˈtiːtʃə/"
      },
      {
        "text": "How old are you?",
        "translation": "መዓልትዎ ስለሚሆን?",
        "phonetic": "/haʊ əʊld ɑːr juː/"
      }
    ],
    "common_error": {
      "wrong": "I have 25 years.",
      "correct": "I am 25 years old.",
      "correct_alt": "",
      "explanation": "ስፓኒሽኛአን 'Tengo 25 años' በማለት የ'ተን' እንቅስቃሴን እንጠቀም፣ የእንግሊዝኛ ግን ለወጪት ዘመን የ'to be' እንቅስቃሴ እንዲጠቀም አለበት። ይህ ለአስፓኒሽ ቋንቋ የሚናገሩት ምርጥ ልዩ ስህተቶች አንዱ ነው።"
    },
    "levels": [
      {
        "level": 1,
        "label": "Age",
        "translation": "ወጪት ዘመን",
        "examples": [
          {
            "original": "I am 30 years old.",
            "phonetic": "/aɪ æm ˈθɜːti jɪəz əʊld/",
            "translation": "የኔ 30 ዓመት ነው።",
            "note": "የ'to be' እንቅስቃሴን ለወጪት ዘመን እንጠቀም።"
          }
        ]
      },
      {
