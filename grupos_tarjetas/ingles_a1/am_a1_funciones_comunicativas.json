[
  {
    "id": "am_A1_func_01",
    "type": "concept",
    "category": "Funciones comunicativas",
    "title": "Greet and introduce yourself",
    "bridge": "ስፓኒሽኛአን, ለሰላም መልእክት ማድረግ የሚጠቀሙት 'Hola' ወይም 'Buenos días' ናቸው፣ ለራስን መግቢያ መስጠትም 'Me llamo...' ወይም 'Soy...' ይላሉ። እንግሊዝኛ በሙሉ አግባብ ነው፤ 'Hello' ወይም 'Good morning' እና 'My name is...' ወይም 'I am...' እንደሚለዉ ይሄን ይጠቀማሉ። የተለየ ልዩነት እንግሊዝኛ ውስጥ 'I am called...' እንደሚል አይደለም (የተላኪ ጥያቄ ነው፣ የቀጥታ መገለጫ ግን በቀጣይ የሚያስፈልጉ የማይሆን ነው)። በእንግሊዝኛ ስማ ማረጋገጫ ለማውጣት 'to be' ተሰኪውን በቀጣይ ይጠቀማሉ፤ 'What is your name?' (ሰኞ 'How are you called?' አይደለም)።",
    "rule": "ሰላም መልእክት፦ 'Hello' (Hola), 'Hi' (በጣም የተለየ), 'Good morning' (Buenos días), 'Good afternoon' (Buenas tardes), 'Good evening' (Buenas noches በማጸው)። ራስን መግቢያ መስጠት፦ 'My name is...' (Me llamo...) ወይም 'I am...' (Soy...)። ስም ማረጋገጫ፦ 'What is your name?' (¿Cómo te llamas?)። ሰላም መልእክት መመርመር፦ 'Nice to meet you' (Encantado/a de conocerte) እና መልሱ 'Nice to meet you too' ። መወዳኅት፦ 'Goodbye', 'Bye', 'See you later'።",
    "concept_examples": [
      {
        "text": "Hello, my name is Maria.",
        "translation": "Hola, me llamo María.",
        "phonetic": "/həˈləʊ maɪ neɪm ɪz məˈriːə/"
      },
      {
        "text": "Good morning, I am Peter.",
        "translation": "Buenos días, soy Peter.",
        "phonetic": "/ɡʊd ˈmɔːnɪŋ aɪ æm ˈpiːtə/"
      },
      {
        "text": "Nice to meet you.",
        "translation": "Encantado/a de conocerte.",
        "phonetic": "/naɪs tə miːt juː/"
      },
      {
        "text": "What is your name?",
        "translation": "¿Cómo te llamas?",
        "phonetic": "/wɒt ɪz jɔː neɪm/"
      }
    ],
    "common_error": {
      "wrong": "I am called Anna.",
      "correct": "My name is Anna.",
      "correct_alt": "I am Anna.",
      "explanation": "ስፓኒሽኛ ውስጥ 'Me llamo Anna' እንደሚል እንደሚለዉ እንደሚያውቁናቸው ነው፣ የእንግሊዝኛ ግን 'My name is...' ወይም 'I am...' ሲሆን 'I am called' በቀጣይ የሚያስፈልጉ የማይሆን በቀጥታ መገለጫ ነው።"
    },
    "levels": [
      {
