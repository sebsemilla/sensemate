      ],
      "dialogue": [
        {
          "speaker": "Verkäuferin",
          "text": "Hallo. Kann ich Ihnen helfen?",
          "translation": "Hola. ¿Puedo ayudarle?",
          "note": "Ofrecimiento de ayuda en la tienda; forma formal 'Ihnen'."
        },
        {
          "speaker": "Kunde",
          "text": "Ja, ich möchte ein T-Shirt kaufen.",
          "translation": "Sí, quisiera comprar una remera.",
          "note": "'Möchte' es la forma cortés de 'querer', muy usada al pedir cosas."
        },
        {
          "speaker": "Verkäuferin",
          "text": "Welche Größe brauchen Sie?",
          "translation": "¿Qué talle necesita?",
          "note": "'Welche' (cuál/qué) concuerda en género con 'Größe' (femenino)."
        },
        {
          "speaker": "Kunde",
          "text": "Ich brauche Größe M. Darf ich es anprobieren?",
          "translation": "Necesito el talle M. ¿Puedo probármela?",
          "note": "'Darf ich...?' es la forma habitual para pedir permiso."
        },
        {
          "speaker": "Verkäuferin",
          "text": "Natürlich. Die Umkleidekabine ist dort.",
          "translation": "Por supuesto. El probador está ahí.",
          "note": "'Die Umkleidekabine' = el probador (palabra compuesta, típica del alemán)."
        },
        {
          "speaker": "Kunde",
          "text": "Es passt gut. Was kostet es?",
          "translation": "Me queda bien. ¿Cuánto cuesta?",
          "note": "'Es passt' (queda bien) se usa siempre en singular, sin importar la prenda."
        },
        {
          "speaker": "Verkäuferin",
          "text": "Es kostet zwanzig Euro.",
          "translation": "Cuesta veinte euros.",
          "note": "Los números en alemán van antes del sustantivo, como en español."
        },
        {
          "speaker": "Kunde",
          "text": "Gut, ich nehme es.",
          "translation": "Bien, me la llevo.",
          "note": "Frase típica para cerrar una compra."
        }
      ]
    }
  }
